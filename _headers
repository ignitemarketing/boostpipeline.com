# Cloudflare Pages response headers.
# CSP ships as Report-Only first: check the browser console on the live
# page, then rename the header to Content-Security-Policy. Drop
# https://cdn.tailwindcss.com and 'unsafe-inline' from script-src once
# the page stops loading the Tailwind Play CDN.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://cdn.tailwindcss.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The pages.dev host duplicates boostpipeline.com; keep it out of search
# results. (Pages already sends noindex on preview deployments.)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
